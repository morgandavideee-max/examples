import React, { useState, useEffect } from 'react';
import { Sparkles, Trophy, Star, Zap, ShoppingBag, Package } from 'lucide-react';

export default function ClickerGame() {
  const [score, setScore] = useState(0);
  const [totalClicks, setTotalClicks] = useState(0);
  const [clickPower, setClickPower] = useState(1);
  const [particles, setParticles] = useState([]);
  const [level, setLevel] = useState(1);
  const [achievements, setAchievements] = useState([]);
  const [ripples, setRipples] = useState([]);
  const [activeTab, setActiveTab] = useState('game');
  const [inventory, setInventory] = useState([]);
  const [equippedCosmetics, setEquippedCosmetics] = useState({
    button: null,
    particle: null,
    background: null
  });

  const shopItems = [
    { id: 'btn_fire', name: 'Bouton Feu', type: 'button', price: 500, gradient: 'from-red-500 via-orange-500 to-yellow-500', icon: '🔥' },
    { id: 'btn_ice', name: 'Bouton Glace', type: 'button', price: 500, gradient: 'from-cyan-400 via-blue-500 to-indigo-600', icon: '❄️' },
    { id: 'btn_nature', name: 'Bouton Nature', type: 'button', price: 750, gradient: 'from-green-400 via-emerald-500 to-teal-600', icon: '🌿' },
    { id: 'part_hearts', name: 'Particules Cœurs', type: 'particle', price: 300, symbol: '❤️' },
    { id: 'part_stars', name: 'Particules Étoiles', type: 'particle', price: 300, symbol: '⭐' },
    { id: 'bg_sunset', name: 'Coucher de Soleil', type: 'background', price: 1500, gradient: 'from-orange-600 via-red-500 to-pink-600', icon: '🌅' },
    { id: 'bg_ocean', name: 'Océan', type: 'background', price: 1500, gradient: 'from-blue-400 via-cyan-500 to-teal-600', icon: '🌊' },
  ];

  const achievementsList = [
    { id: 1, name: "Premier Clic", desc: "Faire votre premier clic", requirement: 1, icon: "🎯" },
    { id: 2, name: "Débutant", desc: "Atteindre 100 points", requirement: 100, icon: "⭐" },
    { id: 3, name: "Expert", desc: "Atteindre 1000 points", requirement: 1000, icon: "💫" },
    { id: 4, name: "Clickeur Fou", desc: "Faire 100 clics", requirement: 100, type: "clicks", icon: "🔥" },
  ];

  useEffect(() => {
    const newLevel = Math.floor(score / 500) + 1;
    if (newLevel > level) {
      setLevel(newLevel);
      setClickPower(newLevel);
    }
  }, [score, level]);

  const handleClick = (e) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    setScore(score + clickPower);
    setTotalClicks(totalClicks + 1);

    const newRipple = { id: Date.now() + Math.random(), x: e.clientX, y: e.clientY };
    setRipples(prev => [...prev, newRipple]);
    setTimeout(() => setRipples(prev => prev.filter(r => r.id !== newRipple.id)), 600);

    const particleSymbol = equippedCosmetics.particle 
      ? shopItems.find(item => item.id === equippedCosmetics.particle)?.symbol 
      : null;

    const newParticle = {
      id: Date.now() + Math.random(),
      x, y,
      value: particleSymbol ? `${particleSymbol} +${clickPower}` : `+${clickPower}`
    };
    setParticles(prev => [...prev, newParticle]);
    setTimeout(() => setParticles(prev => prev.filter(p => p.id !== newParticle.id)), 1000);

    achievementsList.forEach(ach => {
      if (!achievements.includes(ach.id)) {
        let unlock = false;
        if (ach.type === "clicks") unlock = totalClicks + 1 >= ach.requirement;
        else unlock = score + clickPower >= ach.requirement;
        if (unlock) setAchievements(prev => [...prev, ach.id]);
      }
    });
  };

  const buyItem = (item) => {
    if (score >= item.price && !inventory.includes(item.id)) {
      setScore(score - item.price);
      setInventory([...inventory, item.id]);
    }
  };

  const equipItem = (itemId) => {
    const item = shopItems.find(i => i.id === itemId);
    if (item) setEquippedCosmetics(prev => ({ ...prev, [item.type]: itemId }));
  };

  const unequipItem = (type) => {
    setEquippedCosmetics(prev => ({ ...prev, [type]: null }));
  };

  const progress = (score % 500) / 500 * 100;
  const currentButtonStyle = equippedCosmetics.button 
    ? shopItems.find(item => item.id === equippedCosmetics.button)?.gradient 
    : 'from-pink-500 via-purple-500 to-blue-500';
  const currentBackground = equippedCosmetics.background
    ? shopItems.find(item => item.id === equippedCosmetics.background)?.gradient
    : 'from-purple-900 via-blue-900 to-indigo-900';

  return (
    <div className={`min-h-screen bg-gradient-to-br ${currentBackground} p-4 md:p-8`}>
      <style>{`
        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
        @keyframes ripple { 0% { transform: scale(0); opacity: 1; } 100% { transform: scale(4); opacity: 0; } }
        @keyframes fadeOut { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-50px); } }
        @keyframes shake { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(-5deg) scale(1.05); } 75% { transform: rotate(5deg) scale(1.05); } }
        .click-button { animation: float 3s ease-in-out infinite; }
        .click-button:active { animation: shake 0.2s ease-in-out; transform: scale(0.95); }
        .particle { animation: fadeOut 1s forwards; }
        .ripple { position: fixed; border-radius: 50%; border: 3px solid white; pointer-events: none; animation: ripple 0.6s ease-out; z-index: 9999; }
      `}</style>

      <div className="max-w-6xl mx-auto">
        <h1 className="text-4xl md:text-5xl font-bold text-white text-center mb-6 flex items-center justify-center gap-3">
          <Sparkles size={40} />
          Clicker Cosmique
          <Sparkles size={40} />
        </h1>

        <div className="flex gap-2 md:gap-4 mb-6 justify-center flex-wrap">
          <button onClick={() => setActiveTab('game')} className={`px-4 md:px-6 py-2 md:py-3 rounded-xl font-bold ${activeTab === 'game' ? 'bg-white text-purple-900' : 'bg-white/20 text-white'}`}>
            🎮 Jeu
          </button>
          <button onClick={() => setActiveTab('shop')} className={`px-4 md:px-6 py-2 md:py-3 rounded-xl font-bold ${activeTab === 'shop' ? 'bg-white text-purple-900' : 'bg-white/20 text-white'}`}>
            🛍️ Boutique
          </button>
          <button onClick={() => setActiveTab('inventory')} className={`px-4 md:px-6 py-2 md:py-3 rounded-xl font-bold ${activeTab === 'inventory' ? 'bg-white text-purple-900' : 'bg-white/20 text-white'}`}>
            📦 Inventaire
          </button>
        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6">
          <div className="bg-white/10 backdrop-blur-lg rounded-xl p-3 md:p-4 border-2 border-white/20">
            <p className="text-purple-200 text-xs md:text-sm">Score</p>
            <p className="text-2xl md:text-3xl font-bold text-white">{score}</p>
          </div>
          <div className="bg-white/10 backdrop-blur-lg rounded-xl p-3 md:p-4 border-2 border-white/20">
            <p className="text-purple-200 text-xs md:text-sm">Niveau</p>
            <p className="text-2xl md:text-3xl font-bold text-white">{level}</p>
          </div>
          <div className="bg-white/10 backdrop-blur-lg rounded-xl p-3 md:p-4 border-2 border-white/20">
            <p className="text-purple-200 text-xs md:text-sm">Clics</p>
            <p className="text-2xl md:text-3xl font-bold text-white">{totalClicks}</p>
          </div>
          <div className="bg-white/10 backdrop-blur-lg rounded-xl p-3 md:p-4 border-2 border-white/20">
            <p className="text-purple-200 text-xs md:text-sm">Items</p>
            <p className="text-2xl md:text-3xl font-bold text-white">{inventory.length}</p>
          </div>
        </div>

        {activeTab === 'game' && (
          <>
            <div className="mb-6 bg-white/10 backdrop-blur-lg rounded-xl p-4 border-2 border-white/20">
              <div className="flex justify-between mb-2">
                <p className="text-white font-semibold">Niveau {level + 1}</p>
                <p className="text-purple-200">{Math.floor(progress)}%</p>
              </div>
              <div className="w-full bg-purple-950/50 rounded-full h-4">
                <div className="h-full bg-gradient-to-r from-pink-500 via-purple-500 to-blue-500 rounded-full transition-all" style={{ width: `${progress}%` }} />
              </div>
              <p className="text-purple-200 text-sm mt-2">Puissance: +{clickPower}</p>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              <div className="lg:col-span-2 relative bg-white/5 backdrop-blur-lg rounded-3xl p-8 md:p-12 border-2 border-white/20 flex items-center justify-center min-h-[300px] md:min-h-[400px]">
                <button onClick={handleClick} className={`click-button relative w-48 h-48 md:w-64 md:h-64 rounded-full bg-gradient-to-br ${currentButtonStyle} shadow-2xl flex items-center justify-center text-white font-bold text-2xl md:text-3xl border-4 border-white/30`}>
                  <div className="flex flex-col items-center">
                    <Sparkles size={48} className="mb-2" />
                    <span>CLIQUEZ!</span>
                  </div>
                </button>
                {particles.map(p => (
                  <div key={p.id} className="particle absolute text-2xl md:text-3xl font-bold text-yellow-300 pointer-events-none" style={{ left: `${p.x}px`, top: `${p.y}px` }}>
                    {p.value}
                  </div>
                ))}
              </div>

              <div className="bg-white/10 backdrop-blur-lg rounded-xl p-4 border-2 border-white/20">
                <h2 className="text-xl font-bold text-white mb-4 flex items-center gap-2">
                  <Trophy size={24} />
                  Succès
                </h2>
                <div className="space-y-2">
                  {achievementsList.map(ach => (
                    <div key={ach.id} className={`p-3 rounded-xl border-2 ${achievements.includes(ach.id) ? 'bg-yellow-500/20 border-yellow-400/50' : 'bg-white/5 border-white/10 opacity-50'}`}>
                      <div className="flex items-center gap-2">
                        <span className="text-xl">{ach.icon}</span>
                        <div className="flex-1">
                          <p className="text-white font-semibold text-sm">{ach.name}</p>
                          <p className="text-purple-200 text-xs">{ach.desc}</p>
                        </div>
                        {achievements.includes(ach.id) && <span className="text-green-400">✓</span>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </>
        )}

        {activeTab === 'shop' && (
          <div className="bg-white/10 backdrop-blur-lg rounded-xl p-4 md:p-6 border-2 border-white/20">
            <h2 className="text-2xl font-bold text-white mb-6">🛍️ Boutique</h2>
            <div className="space-y-6">
              <div>
                <h3 className="text-lg font-bold text-white mb-3">🎨 Boutons</h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {shopItems.filter(i => i.type === 'button').map(item => (
                    <div key={item.id} className={`p-4 rounded-xl border-2 ${inventory.includes(item.id) ? 'bg-green-500/20 border-green-400/50' : 'bg-white/5 border-white/20'}`}>
                      <div className={`h-20 rounded-xl bg-gradient-to-br ${item.gradient} mb-2 flex items-center justify-center text-3xl`}>{item.icon}</div>
                      <h4 className="text-white font-bold text-sm mb-1">{item.name}</h4>
                      <p className="text-yellow-300 font-bold mb-2">💰 {item.price}</p>
                      {inventory.includes(item.id) ? (
                        <div className="text-green-400 font-bold text-center text-sm">✓ Possédé</div>
                      ) : (
                        <button onClick={() => buyItem(item)} disabled={score < item.price} className={`w-full py-2 rounded-lg font-bold text-sm ${score >= item.price ? 'bg-yellow-500 text-black' : 'bg-gray-600 text-gray-400'}`}>
                          {score >= item.price ? 'Acheter' : 'Pas assez'}
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <h3 className="text-lg font-bold text-white mb-3">✨ Particules</h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {shopItems.filter(i => i.type === 'particle').map(item => (
                    <div key={item.id} className={`p-4 rounded-xl border-2 ${inventory.includes(item.id) ? 'bg-green-500/20 border-green-400/50' : 'bg-white/5 border-white/20'}`}>
                      <div className="h-20 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 mb-2 flex items-center justify-center text-4xl">{item.symbol}</div>
                      <h4 className="text-white font-bold text-sm mb-1">{item.name}</h4>
                      <p className="text-yellow-300 font-bold mb-2">💰 {item.price}</p>
                      {inventory.includes(item.id) ? (
                        <div className="text-green-400 font-bold text-center text-sm">✓ Possédé</div>
                      ) : (
                        <button onClick={() => buyItem(item)} disabled={score < item.price} className={`w-full py-2 rounded-lg font-bold text-sm ${score >= item.price ? 'bg-yellow-500 text-black' : 'bg-gray-600 text-gray-400'}`}>
                          {score >= item.price ? 'Acheter' : 'Pas assez'}
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <h3 className="text-lg font-bold text-white mb-3">🎭 Arrière-plans</h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {shopItems.filter(i => i.type === 'background').map(item => (
                    <div key={item.id} className={`p-4 rounded-xl border-2 ${inventory.includes(item.id) ? 'bg-green-500/20 border-green-400/50' : 'bg-white/5 border-white/20'}`}>
                      <div className={`h-20 rounded-xl bg-gradient-to-br ${item.gradient} mb-2 flex items-center justify-center text-3xl`}>{item.icon}</div>
                      <h4 className="text-white font-bold text-sm mb-1">{item.name}</h4>
                      <p className="text-yellow-300 font-bold mb-2">💰 {item.price}</p>
                      {inventory.includes(item.id) ? (
                        <div className="text-green-400 font-bold text-center text-sm">✓ Possédé</div>
                      ) : (
                        <button onClick={() => buyItem(item)} disabled={score < item.price} className={`w-full py-2 rounded-lg font-bold text-sm ${score >= item.price ? 'bg-yellow-500 text-black' : 'bg-gray-600 text-gray-400'}`}>
                          {score >= item.price ? 'Acheter' : 'Pas assez'}
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'inventory' && (
          <div className="bg-white/10 backdrop-blur-lg rounded-xl p-4 md:p-6 border-2 border-white/20">
            <h2 className="text-2xl font-bold text-white mb-6">📦 Inventaire</h2>
            {inventory.length === 0 ? (
              <div className="text-center py-12">
                <p className="text-white text-xl">Inventaire vide</p>
                <p className="text-purple-200">Achetez des cosmétiques !</p>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                {shopItems.filter(i => inventory.includes(i.id)).map(item => {
                  const isEquipped = equippedCosmetics[item.type] === item.id;
                  return (
                    <div key={item.id} className={`p-4 rounded-xl border-2 ${isEquipped ? 'bg-blue-500/30 border-blue-400' : 'bg-white/5 border-white/20'}`}>
                      <div className={`h-20 rounded-xl ${item.type === 'button' || item.type === 'background' ? `bg-gradient-to-br ${item.gradient}` : 'bg-gradient-to-br from-purple-500 to-pink-500'} mb-2 flex items-center justify-center text-3xl`}>
                        {item.icon || item.symbol}
                      </div>
                      <h4 className="text-white font-bold text-sm mb-3">{item.name}</h4>
                      {isEquipped ? (
                        <>
                          <div className="text-blue-400 font-bold text-center text-sm mb-2">✓ Équipé</div>
                          <button onClick={() => unequipItem(item.type)} className="w-full py-2 rounded-lg font-bold text-sm bg-red-500 text-white">
                            Retirer
                          </button>
                        </>
                      ) : (
                        <button onClick={() => equipItem(item.id)} className="w-full py-2 rounded-lg font-bold text-sm bg-green-500 text-white">
                          Équiper
                        </button>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        )}

        {ripples.map(r => (
          <div key={r.id} className="ripple" style={{ left: `${r.x}px`, top: `${r.y}px`, width: '50px', height: '50px', marginLeft: '-25px', marginTop: '-25px' }} />
        ))}
      </div>
    </div>
  );
}
